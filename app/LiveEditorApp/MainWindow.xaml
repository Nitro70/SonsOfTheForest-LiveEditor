<Window x:Class="LiveEditorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sons of the Forest — Live Editor" Height="760" Width="1120"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- connection / live state bar -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="10" CornerRadius="4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource Danger}" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Disconnected" FontWeight="SemiBold" Margin="0,0,18,0"/>
                <TextBlock Text="World:" Foreground="{StaticResource Muted}" Margin="0,0,4,0"/>
                <TextBlock x:Name="WorldText" Text="—" Margin="0,0,18,0"/>
                <TextBlock Text="Mode:" Foreground="{StaticResource Muted}" Margin="0,0,4,0"/>
                <TextBlock x:Name="ModeText" Text="—" Margin="0,0,18,0"/>
                <TextBlock Text="Cheats:" Foreground="{StaticResource Muted}" Margin="0,0,4,0"/>
                <TextBlock x:Name="CheatsText" Text="—" Margin="0,0,18,0"/>
                <Button Content="Connect" Click="OnConnectClick"/>
                <Button Content="Refresh state" Click="OnRefreshStateClick"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="#3A3D42">
            <!-- ITEMS -->
            <TabItem Header="Items">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Search:" Margin="0,0,6,0"/>
                        <TextBox x:Name="ItemSearch" Width="260" TextChanged="OnItemSearchChanged"/>
                        <Button Content="Load items" Click="OnLoadItemsClick" Margin="10,0,6,0"/>
                        <TextBlock x:Name="ItemCountText" Text="" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
                        <TextBlock Text="shift-click = range, ctrl-click = pick individually"
                                   Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>

                    <!-- Extended = File Explorer behaviour: shift-click selects a
                         range, ctrl-click toggles individuals. The global DataGrid
                         style is Single, so this override is what enables it. -->
                    <DataGrid Grid.Row="1" x:Name="ItemGrid"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="OnItemSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Internal" Binding="{Binding InternalName}" Width="2*"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding MaxAmount}" Width="60"/>
                            <DataGridTextColumn Header="spawnitem?" Binding="{Binding SpawnableText}" Width="90"/>
                            <DataGridTextColumn Header="Platable" Binding="{Binding PlatableText}" Width="80"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Qty:" Margin="0,0,6,0"/>
                        <TextBox x:Name="QtyBox" Text="1" Width="50" Margin="0,0,12,0"/>
                        <CheckBox x:Name="PlatedBox" Content="Solafite plated"
                                  Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="Only works on items marked Platable. Applies to Add and to direct-strategy Spawn."/>
                        <Button Content="Add to inventory" Click="OnAddItemClick"/>
                        <Button Content="Remove from inventory" Click="OnRemoveItemClick"/>
                        <Button Content="Plate owned" Click="OnPlateItemClick"/>
                        <Separator Width="12" Opacity="0"/>
                        <TextBlock Text="Spawn at:" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SpawnAtBox" Width="90" SelectedIndex="0" Margin="0,0,10,0">
                            <ComboBoxItem Content="look"/>
                            <ComboBoxItem Content="front"/>
                        </ComboBox>
                        <TextBlock Text="Strategy:" Margin="0,0,6,0"/>
                        <ComboBox x:Name="StrategyBox" Width="110" SelectedIndex="0" Margin="0,0,10,0">
                            <ComboBoxItem Content="auto"/>
                            <ComboBoxItem Content="direct"/>
                            <ComboBoxItem Content="bolt"/>
                            <ComboBoxItem Content="console"/>
                        </ComboBox>
                        <Button Content="Spawn in world" Click="OnSpawnItemClick"/>
                        <Button Content="Inspect prefab" Click="OnReconClick"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- CONSOLE -->
            <TabItem Header="Console">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Filter:" Margin="0,0,6,0"/>
                        <TextBox x:Name="CmdSearch" Width="260" TextChanged="OnCmdSearchChanged"/>
                        <Button Content="Load commands" Click="OnLoadCommandsClick" Margin="10,0,6,0"/>
                        <TextBlock x:Name="CmdCountText" Text="" Foreground="{StaticResource Muted}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="CmdGrid" SelectionChanged="OnCmdSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Command" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Args" Binding="{Binding Args}" Width="80"/>
                            <DataGridTextColumn Header="Hidden" Binding="{Binding HiddenText}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Command line:" Margin="0,0,6,0"/>
                            <TextBox x:Name="CmdLine" Width="420" Margin="0,0,8,0"
                                     KeyDown="OnCmdLineKeyDown"/>
                            <Button Content="Run" Click="OnRunCommandClick"/>
                            <TextBlock Text="(spawnitem is auto-unlocked for blocked items)"
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Output" Foreground="{StaticResource Muted}" Margin="0,8,0,3"/>
                        <TextBox x:Name="CmdOutput" Height="120" IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ITEM MODULES -->
            <TabItem Header="Item Data">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"
                               Text="Per-instance data on an item you already own. Only 6 of the 10 module types are true yes/no switches; 3 are numeric and 2 are structural (read-only). Select an item on the Items tab — its current values load in automatically."/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="ModuleItemText" Text="No item selected" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <Button Content="Read modules" Click="OnReadModulesClick"/>
                        <CheckBox x:Name="ModuleAllBox" Content="Apply to all copies" IsChecked="True"
                                  Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2">
                        <StackPanel>
                            <TextBlock Text="Booleans" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,12">
                                <CheckBox x:Name="ModPlating" Content="plating (solafite)" Margin="0,0,16,6"/>
                                <CheckBox x:Name="ModPauseDecay" Content="pauseDecay (never rots)" Margin="0,0,16,6"/>
                                <CheckBox x:Name="ModArrowUpgrade" Content="arrowUpgradeActive" Margin="0,0,16,6"/>
                                <CheckBox x:Name="ModGpsActive" Content="gpsActive" Margin="0,0,16,6"/>
                                <CheckBox x:Name="ModGpsPulse" Content="gpsPulse" Margin="0,0,16,6"/>
                                <CheckBox x:Name="ModGpsBeep" Content="gpsBeep" Margin="0,0,16,6"/>
                                <CheckBox x:Name="ModLimbFresh" Content="limbFresh" Margin="0,0,16,6"/>
                            </WrapPanel>
                            <TextBlock Text="Ticked = on, empty = off. Every box is sent, so these are the exact settings the item ends up with. Selecting a single item loads its current values in first, so anything you don't touch stays as it is."
                                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>

                            <TextBlock Text="Numeric — blank means 'do not change'" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="ammoCount" Margin="0,0,4,0"/>
                                <TextBox x:Name="ModAmmoCount" Width="70" Margin="0,0,14,0"/>
                                <TextBlock Text="ammoType (id)" Margin="0,0,4,0"/>
                                <TextBox x:Name="ModAmmoType" Width="70" Margin="0,0,14,0"/>
                                <TextBlock Text="variant" Margin="0,0,4,0"/>
                                <TextBox x:Name="ModVariant" Width="60" Margin="0,0,14,0"/>
                                <TextBlock Text="fill (0-1)" Margin="0,0,4,0"/>
                                <TextBox x:Name="ModFill" Width="60"/>
                            </StackPanel>

                            <TextBlock Text="Current state" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModuleReadout" Height="180" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Apply to owned item" Click="OnApplyModulesClick"/>
                        <Button Content="Add NEW item with these" Click="OnAddWithModulesClick"/>
                        <Button Content="Clear inputs" Click="OnClearModulesClick"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- PLAYER -->
            <TabItem Header="Player">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Read stats" Click="OnPlayerGetClick"/>
                        <Button Content="Restore everything" Click="OnPlayerRestoreClick"/>
                        <TextBlock Text="(reads live from LocalPlayer.Vitals — needs to be in a world)"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="StatGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stat" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="110"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="110"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="110"/>
                            <DataGridTextColumn Header="" Binding="{Binding Bar}" Width="220"/>
                            <DataGridTextColumn Header="Behaviour" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Set" Margin="0,0,6,0"/>
                        <ComboBox x:Name="StatBox" Width="130" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="health"/>
                            <ComboBoxItem Content="stamina"/>
                            <ComboBoxItem Content="hydration"/>
                            <ComboBoxItem Content="fullness"/>
                            <ComboBoxItem Content="rest"/>
                            <ComboBoxItem Content="vitality"/>
                            <ComboBoxItem Content="sickness"/>
                            <ComboBoxItem Content="strength"/>
                        </ComboBox>
                        <TextBlock Text="to" Margin="0,0,6,0"/>
                        <TextBox x:Name="StatValue" Width="90" Text="100" Margin="0,0,8,0"/>
                        <Button Content="Apply" Click="OnPlayerSetClick"/>
                        <Button Content="Fill to max" Click="OnPlayerMaxClick"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TOOLS -->
            <TabItem Header="Tools &amp; Cheats">
                <ScrollViewer Margin="8">
                    <StackPanel>
                        <TextBlock Text="Spawn gate" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="60 items (artifact pieces, blueprints, notes) are refused by spawnitem. Unlocking clears that gate so they work from the in-game console too. Runtime only — never written to your save."
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Unlock all spawns" Click="OnSpawnUnlockClick"/>
                            <Button Content="Restore" Click="OnSpawnRestoreClick"/>
                        </StackPanel>

                        <TextBlock Text="Console" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Unlock console / cheats" Click="OnConsoleUnlockClick"/>
                            <Button Content="Introspect (hidden check)" Click="OnIntrospectClick"/>
                        </StackPanel>

                        <TextBlock Text="Cheats" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,6"
                                   Text="Click once to turn on, click again to turn off. Green is on, red is off. The app tracks what it has sent — if you also toggle something from the in-game console, the colour here can drift out of step; Re-sync re-reads the states that can actually be read back."/>
                        <WrapPanel x:Name="CheatCorePanel" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="ShowMoreButton" Content="Show more commands  ▾" Click="OnShowMoreCheatsClick"/>
                            <Button Content="Re-sync" Click="OnResyncCheatsClick"
                                    ToolTip="Re-read the states the game will report, and assume the rest are off."/>
                            <Button Content="All off" Click="OnAllCheatsOffClick"
                                    ToolTip="Send the off form of every toggle that is currently showing as on."/>
                        </StackPanel>

                        <StackPanel x:Name="CheatMoreSection" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"
                                       Text="Beyond the common ones. Most of these follow the game's usual '&lt;command&gt; on|off' form, but only some were verified by running them — if one does nothing, that is the game, not the button. Buttons with no colour are one-shot actions, not toggles."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- LOG -->
            <TabItem Header="Log">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                    <Button Grid.Row="1" Content="Clear" Click="OnClearLogClick" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="StatusBar" Text="Ready." Foreground="{StaticResource Muted}" Margin="2,6,0,0"/>
    </Grid>
</Window>
