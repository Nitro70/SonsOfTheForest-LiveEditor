<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LiveEditorApp</AssemblyName>
    <RootNamespace>LiveEditorApp</RootNamespace>
    <ApplicationTitle>SOTF Live Editor</ApplicationTitle>
  </PropertyGroup>

  <!-- Release builds ship self-contained so the installer never has to detect or
       install a .NET runtime. WPF cannot be trimmed, so this is a large single file
       (~70 MB compressed) — worth it for a genuinely prompt-free install. -->
  <PropertyGroup Label="Publish">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
